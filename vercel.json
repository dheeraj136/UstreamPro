{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.json"
    },
    {
      "source": "/api/sports",
      "destination": "/api/sports.json"
    },
    {
      "source": "/api/livetv",
      "destination": "/api/sports.json"
    },
    {
      "source": "/api/(.+)",
      "destination": "/api?endpoint=/$1"
    }
  ]
}
