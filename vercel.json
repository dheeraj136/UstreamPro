{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-6O67DjTf+tsVLoOSTvJyPnMM+O8W4wao45I1N2tUwhQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://image.tmdb.org https://static.tvmaze.com; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://api.themoviedb.org https://api.tvmaze.com; frame-src https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://ustream-pro.vercel.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS, POST"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Accept"
        }
      ],
      "source": "/api/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ],
      "source": "/"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ],
      "source": "/index.html"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ],
      "source": "/assets/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ],
      "source": "/modules/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/(app|styles)\\.([0-9a-f]{8})\\.(js|css)"
    }
  ],
  "rewrites": [
    {
      "destination": "/api/health.json",
      "source": "/api/health"
    },
    {
      "destination": "/api/catalog.json",
      "source": "/api/catalog"
    },
    {
      "destination": "/api/search.json",
      "source": "/api/search"
    },
    {
      "destination": "/api/videos.json",
      "source": "/api/videos"
    }
  ]
}
