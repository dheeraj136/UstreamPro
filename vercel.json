{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.json"
    },
    {
      "source": "/api/sports",
      "destination": "/api/sports.json"
    },
    {
      "source": "/api/livetv",
      "destination": "/api/sports.json"
    }
  ]
}
