{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/healthz", "dest": "/api/index.js" },
    { "src": "/.netlify/functions/api", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
