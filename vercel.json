{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.json"
    },
    {
      "source": "/api/test",
      "destination": "/api/test.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ]
}
