{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.json"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.json"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/catalog.json"
    },
    {
      "source": "/api/search",
      "destination": "/api/search.json"
    },
    {
      "source": "/api/videos",
      "destination": "/api/videos.json"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/health.json"
    }
  ]
}
