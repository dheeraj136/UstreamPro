{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/config",
      "dest": "/api/config.json"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.json"
    },
    {
      "src": "/api/catalog",
      "dest": "/api/catalog.json"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.json"
    },
    {
      "src": "/api/videos",
      "dest": "/api/videos.json"
    },
    {
      "src": "/api/sports",
      "dest": "/api/sports.json"
    },
    {
      "src": "/api/livetv",
      "dest": "/api/sports.json"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/health.json"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
