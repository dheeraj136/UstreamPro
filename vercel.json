{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-6O67DjTf+tsVLoOSTvJyPnMM+O8W4wao45I1N2tUwhQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://image.tmdb.org https://static.tvmaze.com https://archive.org https://*.archive.org; font-src 'self' data:; media-src 'self' blob: https://archive.org https://*.archive.org; connect-src 'self' https://api.tvmaze.com https://archive.org https://*.archive.org; frame-src 'self' https://www.youtube-nocookie.com https:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/modules/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(app|styles)\\.([0-9a-f]{8})\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/anime-world-india/v1/(.*)",
      "destination": "/api/animeworld?path=$1"
    },
    {
      "source": "/api/animeworld",
      "destination": "/api/animeworld"
    },
    {
      "source": "/api/auth",
      "destination": "/api/router?endpoint=/auth"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/router?endpoint=/auth/$1"
    },
    {
      "source": "/api/profiles",
      "destination": "/api/router?endpoint=/profiles"
    },
    {
      "source": "/api/profiles/(.*)",
      "destination": "/api/router?endpoint=/profiles/$1"
    },
    {
      "source": "/api/profile/(.*)",
      "destination": "/api/router?endpoint=/profile/$1"
    },
    {
      "source": "/api/videos",
      "destination": "/api/router?endpoint=/videos"
    },
    {
      "source": "/api/videos/(.*)",
      "destination": "/api/router?endpoint=/videos/$1"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  }
}
