# UstreamPro local development
# Keep real secrets in .env (never commit it) or Vercel Project Settings > Environment Variables.

# Optional but recommended: TMDB v3 API key for the server-side proxy.
# If unset, the browser can still attempt the existing public fallback keys.
TMDB_API_KEY=

# Local development server
PORT=4174
HOST=0.0.0.0
