# UstreamPro Environment Configuration
# Copy this file to .env for local development. Never commit .env or real secrets.
# On Vercel, configure variables in: Vercel Dashboard -> Project Settings -> Environment Variables, then redeploy.

# ==============================================================================
# 1. TMDB Metadata, Trailers & Watch Providers (JustWatch via TMDB)
# ==============================================================================
# Required for /api/tmdb server-side proxy (never shipped to client JS).
# Obtain at: https://www.themoviedb.org/settings/api (TMDB API v3 Key)
# Environments: Production, Preview, Development
TMDB_API_KEY=

# Optional alternative to TMDB_API_KEY (TMDB API v4 Read Access Token / Bearer).
# Obtain at: https://www.themoviedb.org/settings/api
# Environments: Production, Preview, Development (Optional)
TMDB_ACCESS_TOKEN=

# ==============================================================================
# 2. Google OAuth Sign-In (Optional)
# ==============================================================================
# Used by /api/auth/google and /api/auth/google/callback when authentication is enabled.
# Obtain at: https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID)
# Environments: Production, Preview, Development (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional explicit OAuth callback URL override.
# If omitted, derived automatically from the incoming request origin
# (e.g. https://ustream-pro.vercel.app/api/auth/google/callback or http://localhost:4174/api/auth/google/callback).
# Environments: Production, Preview, Development (Optional)
GOOGLE_REDIRECT_URI=

# ==============================================================================
# 3. Authentication & Database Storage
# ==============================================================================
# Local file path for auth/profile/video metadata storage in Development / self-hosted Node.
# Defaults to ./data/ustream-auth-db.json locally.
# Environments: Development
DATABASE_PATH=

# Set to "1" ONLY if you want to test ephemeral /tmp auth in a Vercel Preview deployment
# without a persistent external database. Never enable in Production.
# Environments: Preview (Optional, testing only)
USTREAM_ENABLE_EPHEMERAL_AUTH=

# ==============================================================================
# 4. Community Video Uploads (Object Storage)
# ==============================================================================
# Required on Vercel to enable persistent community video uploads (Vercel Blob).
# Obtain at: Vercel Dashboard -> Storage -> Create Blob Store -> BLOB_READ_WRITE_TOKEN.
# Locally, uploads are stored under ./data/uploads without needing this token.
# Environments: Production, Preview (Optional; uploads disabled on Vercel if unset)
BLOB_READ_WRITE_TOKEN=

# ==============================================================================
# 5. CORS & Local Dev Server
# ==============================================================================
# Optional comma-separated list of extra allowed CORS origins (e.g. custom domain).
# Production, Vercel preview URLs, and localhost are allowed automatically.
# Environments: Production, Preview, Development (Optional)
CORS_ALLOWED_ORIGINS=

# Local Node server port and bind host (scripts/server.mjs)
# Environments: Development
PORT=4174
HOST=0.0.0.0

# ==============================================================================
# 6. AnimeWorld India Streaming API (Optional Custom Base/Proxy)
# ==============================================================================
# Base URL for upstream AnimeWorld scraper (defaults to https://animeworld-india.me).
# Environments: Production, Preview, Development (Optional)
ANIMEWORLD_BASE_URL=

# Optional proxy URL (e.g. for bypassing ISP/geo blocks when scraping upstream).
# Environments: Production, Preview, Development (Optional)
ANIMEWORLD_PROXY_URL=
